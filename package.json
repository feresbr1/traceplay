{
  "name": "traceplay",
  "version": "1.0.0",
  "description": "Turn any algorithm or function into an interactive step-by-step animation. Every frame comes from actually running the code. Works with your AI coding agent.",
  "type": "module",
  "license": "MIT",
  "author": "Feres Ben Brahim",
  "homepage": "https://feresbr1.github.io/traceplay/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feresbr1/traceplay.git"
  },
  "bugs": {
    "url": "https://github.com/feresbr1/traceplay/issues"
  },
  "keywords": [
    "algorithm-visualizer",
    "algorithm-visualization",
    "data-structures",
    "animation",
    "education",
    "agent-skill",
    "claude-code",
    "visualization"
  ],
  "bin": {
    "traceplay": "dist/cli/traceplay.mjs"
  },
  "files": [
    "dist/cli",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:cli",
    "build:web": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview --port 4176 --strictPort",
    "deploy": "node scripts/deploy-pages.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "preact": "^11.0.1",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
